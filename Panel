    return {
      id: "quest", label: "Quests", title: "Auto Quest", icon: "trophy", view, extra, syncExtra: updateExtra, skip: skipCurrent,
      isOn: () => running && !ctl.paused && !S.finished,
      toggle: async (v) => { if (unavailable) return; if (v) { (S.finished || !running) ? rescan() : resume(); } else pause(); },
      render,
