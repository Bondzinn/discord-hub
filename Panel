  // ======================================================================
  //  MÓDULO 1 • AUTO QUEST (roda sozinho ao executar)
  // ======================================================================
  const quest = (() => {
    const STALL_MS = 5 * 60000, MAX_TRIES = 3;
    const DESKTOP_ONLY = ["PLAY_ON_DESKTOP", "STREAM_ON_DESKTOP"];
    const SUPPORTED = ["WATCH_VIDEO", "WATCH_VIDEO_ON_MOBILE", "PLAY_ON_DESKTOP", "STREAM_ON_DESKTOP", "PLAY_ACTIVITY"];
    const TASK_LABEL = {
      WATCH_VIDEO: "Assistindo vídeo", WATCH_VIDEO_ON_MOBILE: "Assistindo vídeo",
      PLAY_ON_DESKTOP: "Simulando jogo", STREAM_ON_DESKTOP: "Simulando stream (1 pessoa na call)",
      PLAY_ACTIVITY: "Completando atividade",
    };
    const view = makeView();
    const unavailable = !api ? "Cliente de API do Discord não encontrado." : (!QuestsStore || !FluxDispatcher ? "Módulos de quests não encontrados." : null);

    const ctl = { paused: false, cancelled: false, skip: false, cancel: null, session: null };
    const ok = new Set(), failed = new Set(), tries = new Map(), skipped = new Set();
    const S = {
      name: "Procurando missões...", status: "", done: 0, needed: 0, base: 0, baseAt: Date.now(), lastGain: Date.now(),
      live: false, total: 0, concluded: 0, remaining: 0, failed: 0, skipped: 0, pulled: 0, finished: false, warn: false,
    };
    let running = false, curId = null;
    let bgInfo = { key: null, sources: [] };

    const aborted = () => ctl.cancelled || ctl.skip;
    const waitResume = async () => { while (ctl.paused && !aborted()) await sleep(250); };
    const psleep = async (ms) => {
      let left = ms;
      while (left > 0 && !aborted()) {
        if (ctl.paused) { await sleep(250); continue; }
        const s = Math.min(250, left); await sleep(s); left -= s;
      }
    };
    const errMsg = (e) => e?.body?.message ?? e?.message ?? (e?.status ? `HTTP ${e.status}` : String(e));
    const post = async (url, body) => {
      for (let i = 0; i < 4; i++) {
        try {
          const r = await api.post({ url, body });
          if (r?.status === 429) { await psleep(((r.body?.retry_after ?? 5) + 1) * 1000); continue; }
          if (r?.status >= 400) { const e = new Error(r.body?.message ?? `HTTP ${r.status}`); e.status = r.status; throw e; }
          return r;
        } catch (e) {
          if (e?.status === 429 && i < 3) { await psleep(((e.body?.retry_after ?? 5) + 1) * 1000); continue; }
          throw new Error(errMsg(e));
        }
      }
      throw new Error("Limite de requisições (429)");
    };

    const CAT = { WATCH_VIDEO: "video", WATCH_VIDEO_ON_MOBILE: "video", PLAY_ON_DESKTOP: "game", STREAM_ON_DESKTOP: "stream", PLAY_ACTIVITY: "activity" };
    const CAT_LABEL = { video: "Vídeos", game: "Jogos", stream: "Stream", activity: "Atividades" };
    let ORDER = ["video", "game", "stream", "activity"];
    try { const s = (store.get("qorder") ?? "").split(","); if (s.length === 4 && ORDER.every((c) => s.includes(c))) ORDER = s; } catch {}

    const isActiveEnrolled = (q) =>
      q.userStatus?.enrolledAt && new Date(q.config.expiresAt).getTime() > Date.now() &&
      SUPPORTED.some(t => q.config.taskConfigV2?.tasks?.[t]);
    const usableTask = (q) => SUPPORTED.find(t => q.config.taskConfigV2?.tasks?.[t] && (IS_APP || !DESKTOP_ONLY.includes(t))) ?? null;
    const rank = (q) => ORDER.indexOf(CAT[usableTask(q)]);
    const pending = () => [...QuestsStore.quests.values()].filter(q =>
      isActiveEnrolled(q) && !q.userStatus?.completedAt && !ok.has(q.id) && !failed.has(q.id) && !skipped.has(q.id) && usableTask(q))
      .sort((a, b) => rank(a) - rank(b));
    const refreshCounts = () => {
      const all = [...QuestsStore.quests.values()].filter(isActiveEnrolled);
      const usable = all.filter(q => q.userStatus?.completedAt || usableTask(q));
      S.skipped = all.filter(q => !q.userStatus?.completedAt && !usableTask(q)).length;
      S.total = usable.length;
      S.concluded = usable.filter(q => q.userStatus?.completedAt || ok.has(q.id)).length;
      S.failed = usable.filter(q => failed.has(q.id)).length;
      S.pulled = usable.filter(q => skipped.has(q.id) && !q.userStatus?.completedAt && !ok.has(q.id)).length;
      S.remaining = Math.max(0, S.total - S.concluded - S.failed - S.pulled);
    };
    const appIdOf = (q) => {
      const tasks = q.config.taskConfigV2?.tasks ?? {};
      for (const t of Object.values(tasks)) if (t?.applications?.[0]?.id) return t.applications[0].id;
      return q.config.application?.id ?? q.id;
    };
    const currentQuest = (q) => QuestsStore.getQuest?.(q.id) ?? QuestsStore.quests.get(q.id) ?? q;
    const readProgress = (q, taskName) => {
      const cur = currentQuest(q);
      return cur.config.configVersion === 1 ? (cur.userStatus?.streamProgressSeconds ?? 0) : Math.floor(cur.userStatus?.progress?.[taskName]?.value ?? 0);
    };
    const isCompleted = (q) => !!currentQuest(q).userStatus?.completedAt;
    const setReal = (v) => {
      if (typeof v !== "number" || Number.isNaN(v)) return;
      if (v > S.base) { S.base = v; S.baseAt = Date.now(); S.lastGain = Date.now(); }
      S.done = Math.max(S.done, S.base);
      render();
    };
    const checkStall = () => { if (Date.now() - S.lastGain > STALL_MS) throw new Error("Sem progresso do Discord há 5 min"); };

    // Mídia da quest: vídeo (animado) quando existir, imagens como reserva
    const toCdn = (f, q, allowVideo) => {
      if (typeof f !== "string" || !f) return null;
      const isVid = /\.(mp4|webm)(\?|$)/i.test(f);
      if (/\.m3u8(\?|$)/i.test(f)) return null;
      if (isVid !== !!allowVideo) return null;
      if (/^https?:/.test(f)) return f;
      if (f.includes("/")) return `https://cdn.discordapp.com/${f.replace(/^\//, "")}`;
      return `https://cdn.discordapp.com/quests/${q.id}/${f}`;
    };
    const questSources = (q) => {
      const a = q.config.assets ?? {};
      const pref = ["questBarHeroImage", "heroImage", "hero", "gameTile", "gameTileLight", "gameTileDark", "logotype", "logotypeLight", "logotypeDark"];
      const imgs = [...new Set([...pref.map(k => a[k]), ...Object.values(a)].map(v => toCdn(v, q, false)).filter(Boolean))];
      const vids = [...new Set([...Object.entries(a).filter(([k]) => /video/i.test(k)).map(([, v]) => v), ...Object.values(a)].map(v => toCdn(v, q, true)).filter(Boolean))];
      return [
        ...vids.map(url => ({ url, type: "video", still: imgs[0] ?? null })),
        ...imgs.map(url => ({ url, type: /\.gif(\?|$)/i.test(url) ? "anim" : "img" })),
      ];
    };

    const render = () => {
      const pct = S.finished ? (S.concluded > 0 ? 100 : 0) : (S.needed ? Math.min(100, (S.done / S.needed) * 100) : 0);
      const parts = [`Faltam ${S.remaining}`];
      if (S.failed) parts.push(`${S.failed} com erro`);
      if (S.pulled) parts.push(`${S.pulled} puladas`);
      if (S.skipped) parts.push(`${S.skipped} só no app`);
      if (unavailable) {
        return setView(view, { name: "Auto Quest indisponível", status: unavailable, icon: "warn", color: "#ed4245", pct: 0 });
      }
      let status = S.status, icon = S.warn ? "warn" : null;
      if (ctl.paused && !S.finished) { status = "Pausado (ligue o switch para continuar)"; icon = "pause"; }
      setView(view, {
        name: S.name, status, icon, pct,
        color: S.finished ? "#23a55a" : (ctl.paused ? "#f0b232" : "#5865F2"),
        l: !S.finished && S.needed ? `${fmtMin(S.done)} / ${fmtMin(S.needed)}` : "",
        r: S.finished && !S.concluded ? "" : `${Math.floor(pct)}%`,
        flHtml: S.finished ? esc("Ligue o switch para procurar de novo") : parts.map(esc).join(sepHtml),
        flTitle: parts.join(", "),
        fr: `Concluídas ${S.concluded}/${S.total}`,
      });
    };

    const pause = () => {
      if (S.finished || ctl.cancelled || ctl.paused || !running) return;
      S.base = S.done; ctl.paused = true;
      try { ctl.session?.stop?.(); } catch {}
      render(); refreshHub();
    };
    const resume = () => {
      if (!ctl.paused) return;
      ctl.paused = false; S.baseAt = Date.now(); S.lastGain = Date.now();
      try { ctl.session?.start?.(); } catch {}
      render(); refreshHub();
    };

    const ticker = setInterval(() => {
      if (!S.live || ctl.paused || ctl.cancelled || S.finished || !S.needed) return;
      const est = S.base + Math.min(90, (Date.now() - S.baseAt) / 1000);
      S.done = Math.max(S.done, Math.min(S.needed - 1, est));
      render();
    }, 1000);
    onDispose(() => {
      ctl.cancelled = true; ctl.paused = false;
      try { ctl.cancel?.(); } catch {}
      try { ctl.session?.stop?.(); } catch {}
      clearInterval(ticker);
    });

    // ----- tarefas -----
    async function watchVideo(q, taskName, needed) {
      const enrolledAt = new Date(q.userStatus.enrolledAt).getTime();
      const speed = 7;
      let done = q.userStatus?.progress?.[taskName]?.value ?? 0;
      setReal(done);
      let serverDone = false;
      while (done < needed && !aborted()) {
        await waitResume();
        if (aborted()) return false;
        const maxAllowed = Math.floor((Date.now() - enrolledAt) / 1000) + 10;
        if (done + speed > maxAllowed && done + speed < needed) { await psleep(1000); continue; }
        const next = Math.min(needed, done + speed);
        const res = await post(`/quests/${q.id}${X.pVP}`, { timestamp: Math.min(needed, next + Math.random()) });
        if (res?.body?.completed_at != null) serverDone = true;
        done = next; setReal(done);
        if (serverDone) break;
        await psleep(1000);
      }
      if (!serverDone && !aborted()) {
        const res = await post(`/quests/${q.id}${X.pVP}`, { timestamp: needed });
        serverDone = res?.body?.completed_at != null;
      }
      return serverDone;
    }

    async function playOnDesktop(q, needed) {
      if (!RunningGameStore) throw new Error("RunningGameStore não encontrado (use o app desktop)");
      const appId = appIdOf(q);
      const isV1 = q.config.configVersion === 1;
      let app = null;
      try { app = (await api.get({ url: `/applications/public?application_ids=${appId}` }))?.body?.[0] ?? null; } catch {}
      if (!app) {
        const t = q.config.taskConfigV2?.tasks?.PLAY_ON_DESKTOP;
        const fromTask = t?.applications?.[0] ?? q.config.application ?? null;
        app = { id: appId, name: fromTask?.name ?? q.config.messages?.gameTitle ?? "Game", executables: fromTask?.executables };
      }
      const safeName = (app.name ?? "Game").replace(/[\/\\:*?"<>|]/g, "");
      const exeName = (app.executables?.find(x => x.os === "win32")?.name ?? `${safeName}.exe`).replace(">", "");
      const pid = Math.floor(Math.random() * 30000) + 1000;
      const fakeGame = {
        cmdLine: `C:\\Program Files\\${safeName}\\${exeName}`, exeName,
        exePath: `c:/program files/${safeName.toLowerCase()}/${exeName}`,
        hidden: false, isLauncher: false, id: appId, name: app.name ?? safeName,
        pid, pidPath: [pid], processName: app.name ?? safeName, start: Date.now(),
      };
      const prevGet = RunningGameStore.getRunningGames, prevPid = RunningGameStore.getGameForPID;
      let on = false;
      const isFake = (x) => x.id === fakeGame.id && x.pid === fakeGame.pid;
      const myGet = function (...a) {
        const real = prevGet.apply(RunningGameStore, a);
        if (!on || !Array.isArray(real) || real.some(isFake)) return real;
        return [...real, fakeGame];
      };
      const myPid = function (p) { return (on && p === fakeGame.pid) ? fakeGame : prevPid.call(RunningGameStore, p); };
      const start = () => {
        if (on) return; on = true;
        RunningGameStore.getRunningGames = myGet; RunningGameStore.getGameForPID = myPid;
        FluxDispatcher.dispatch({ type: X.evRun, removed: [], added: [fakeGame], games: myGet.call(RunningGameStore) });
      };
      const stopGame = () => {
        if (!on) return; on = false;
        if (RunningGameStore.getRunningGames === myGet) RunningGameStore.getRunningGames = prevGet;
        if (RunningGameStore.getGameForPID === myPid) RunningGameStore.getGameForPID = prevPid;
        FluxDispatcher.dispatch({ type: X.evRun, removed: [fakeGame], added: [], games: RunningGameStore.getRunningGames() });
      };
      setReal(readProgress(q, "PLAY_ON_DESKTOP"));
      S.lastGain = Date.now(); S.live = true;
      ctl.session = { start, stop: stopGame };
      start();
      incrementMetric("gameSimulations");
      const onBeat = (data) => setReal(isV1 ? data?.userStatus?.streamProgressSeconds : Math.floor(data?.userStatus?.progress?.PLAY_ON_DESKTOP?.value ?? 0));
      FluxDispatcher.subscribe(X.evHb, onBeat);
      try {
        await new Promise((resolve, reject) => {
          const poll = setInterval(() => {
            try {
              if (aborted()) { clearInterval(poll); return resolve(); }
              if (ctl.paused) return;
              const p = readProgress(q, "PLAY_ON_DESKTOP"); setReal(p);
              if (p >= needed || isCompleted(q)) { clearInterval(poll); return resolve(); }
              checkStall();
            } catch (e) { clearInterval(poll); reject(e); }
          }, 3000);
          ctl.cancel = () => { clearInterval(poll); resolve(); };
        });
      } finally { FluxDispatcher.unsubscribe(X.evHb, onBeat); stopGame(); S.live = false; }
      return false;
    }

    async function streamOnDesktop(q, needed) {
      if (!StreamingStore) throw new Error("StreamingStore não encontrado (use o app desktop)");
      const appId = appIdOf(q);
      const isV1 = q.config.configVersion === 1;
      const pid = Math.floor(Math.random() * 30000) + 1000;
      const realFunc = StreamingStore.getStreamerActiveStreamMetadata;
      let on = false;
      const start = () => { if (on) return; on = true; StreamingStore.getStreamerActiveStreamMetadata = () => ({ id: appId, pid, sourceName: null }); };
      const stopStream = () => { if (!on) return; on = false; StreamingStore.getStreamerActiveStreamMetadata = realFunc; };
      setReal(readProgress(q, "STREAM_ON_DESKTOP"));
      S.lastGain = Date.now(); S.live = true;
      ctl.session = { start, stop: stopStream };
      start();
      incrementMetric("streamSimulations");
      const onBeat = (data) => setReal(isV1 ? data?.userStatus?.streamProgressSeconds : Math.floor(data?.userStatus?.progress?.STREAM_ON_DESKTOP?.value ?? 0));
      FluxDispatcher.subscribe(X.evHb, onBeat);
      try {
        await new Promise((resolve, reject) => {
          const poll = setInterval(() => {
            try {
              if (aborted()) { clearInterval(poll); return resolve(); }
              if (ctl.paused) return;
              const p = readProgress(q, "STREAM_ON_DESKTOP"); setReal(p);
              if (p >= needed || isCompleted(q)) { clearInterval(poll); return resolve(); }
              checkStall();
            } catch (e) { clearInterval(poll); reject(e); }
          }, 3000);
          ctl.cancel = () => { clearInterval(poll); resolve(); };
        });
      } finally { FluxDispatcher.unsubscribe(X.evHb, onBeat); stopStream(); S.live = false; }
      return false;
    }

    const activityChannels = () => {
      const ids = [];
      try { for (const c of ChannelStore?.getSortedPrivateChannels?.() ?? []) if (c?.id) ids.push(c.id); } catch {}
      try { for (const g of Object.values(GuildChannelStore?.getAllGuilds?.() ?? {})) for (const v of g?.VOCAL ?? []) if (v?.channel?.id) ids.push(v.channel.id); } catch {}
      return [...new Set(ids)].slice(0, 8);
    };

    async function playActivity(q, needed) {
      const channels = activityChannels();
      if (!channels.length) throw new Error("Nenhum canal encontrado para a atividade");
      let ci = 0, noGain = 0, badRuns = 0, beats = 0, serverDone = false;
      setReal(Math.max(q.userStatus?.progress?.PLAY_ACTIVITY?.value ?? 0, readProgress(q, "PLAY_ACTIVITY")));
      S.lastGain = Date.now(); S.live = true;
      try {
        while (!aborted()) {
          await waitResume();
          if (aborted()) return false;
          checkStall();
          const streamKey = `call:${channels[ci]}:1`;
          let res;
          try { res = await post(`/quests/${q.id}${X.pHB}`, { stream_key: streamKey, terminal: false }); badRuns = 0; }
          catch (e) {
            S.status = `${e.message}, trocando de canal`; S.warn = true; render();
            if (++badRuns >= channels.length * 2) throw e;
            ci = (ci + 1) % channels.length;
            await psleep(2000);
            continue;
          }
          beats++;
          const fromRes = res?.body?.progress?.PLAY_ACTIVITY?.value;
          const progress = Math.floor(typeof fromRes === "number" ? fromRes : readProgress(q, "PLAY_ACTIVITY"));
          const before = S.base;
          setReal(progress);
          S.status = `${TASK_LABEL.PLAY_ACTIVITY} (batida ${beats})`; S.warn = false;
          if (S.base > before) noGain = 0;
          else if (++noGain >= 3) { ci = (ci + 1) % channels.length; noGain = 0; }
          if (res?.body?.completed_at != null) { serverDone = true; break; }
          if (progress >= needed) {
            const fin = await post(`/quests/${q.id}${X.pHB}`, { stream_key: streamKey, terminal: true });
            serverDone = fin?.body?.completed_at != null;
            break;
          }
          await psleep(20000);
        }
      } finally { S.live = false; }
      return serverDone;
    }

    const confirmDone = async (q, flag) => {
      if (flag || isCompleted(q)) return true;
      S.status = "Aguardando confirmação do Discord..."; S.warn = false; render();
      for (let i = 0; i < 20 && !ctl.cancelled; i++) { await sleep(1000); if (isCompleted(q)) return true; }
      return false;
    };

    // ----- loop principal -----
    const loop = async () => {
      refreshCounts(); render();
      while (!ctl.cancelled) {
        await waitResume();
        if (ctl.cancelled) return;
        refreshCounts();
        const q = pending()[0];
        if (!q) break;
        curId = q.id; ctl.skip = false;
        const taskName = usableTask(q);
        const needed = q.config.taskConfigV2.tasks[taskName].target;
        const attempt = (tries.get(q.id) ?? 0) + 1;
        S.name = q.config.messages?.questName ?? "Missão";
        S.status = (TASK_LABEL[taskName] ?? taskName) + (attempt > 1 ? ` (tentativa ${attempt}/${MAX_TRIES})` : ""); S.warn = false;
        S.needed = needed; S.done = 0; S.base = 0; S.baseAt = Date.now(); S.lastGain = Date.now(); S.live = false;
        bgInfo = { key: q.id, sources: questSources(q) };
        render(); refreshHub();
        try {
          let flag = false;
          if (taskName === "WATCH_VIDEO" || taskName === "WATCH_VIDEO_ON_MOBILE") flag = await watchVideo(q, taskName, needed);
          else if (taskName === "PLAY_ON_DESKTOP") flag = await playOnDesktop(q, needed);
          else if (taskName === "STREAM_ON_DESKTOP") flag = await streamOnDesktop(q, needed);
          else if (taskName === "PLAY_ACTIVITY") flag = await playActivity(q, needed);
          if (ctl.cancelled) return;
          if (ctl.skip) { ctl.skip = false; continue; }
          if (await confirmDone(q, flag)) { ok.add(q.id); incrementMetric("missions"); S.done = needed; render(); }
          else throw new Error("Discord não confirmou a conclusão");
        } catch (err) {
          if (ctl.cancelled) return;
          if (ctl.skip) { ctl.skip = false; continue; }
          console.error(`[${TITLE}] Erro em "${S.name}" (${taskName}):`, err);
          tries.set(q.id, attempt);
          if (attempt >= MAX_TRIES) failed.add(q.id);
          S.live = false;
          S.status = `${err?.message ?? err}` + (attempt < MAX_TRIES ? ", tentando de novo" : ""); S.warn = true;
          render();
          await sleep(6000);
        } finally { ctl.session = null; ctl.cancel = null; S.live = false; curId = null; }
        refreshCounts(); render();
      }
      if (ctl.cancelled) return;
      refreshCounts();
      S.finished = true; S.needed = 0; S.live = false; S.warn = false;
      bgInfo = { key: null, sources: [] };
      if (S.concluded > 0) {
        S.name = "Sem mais missões";
        S.status = S.failed ? `${S.failed} missão(ões) com erro, veja o console (F12).`
          : S.skipped ? `${S.skipped} missão(ões) de jogo/stream só funcionam no app desktop.`
          : S.pulled ? `${S.pulled} missão(ões) pulada(s). Ligue o switch para tentar de novo.`
          : "Todas as missões aceitas foram concluídas.";
      } else if (S.skipped > 0) {
