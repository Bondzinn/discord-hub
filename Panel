      return apps?.find(a => normGame(a.name) === n) || apps?.find(a => normGame(a.name).startsWith(n)) || apps?.find(a => normGame(a.name).includes(n));
    };
    const loadApps = async () => {
      if (apps) return true;
      try { const r = await fetch("https://discord.com/api/v9/applications/detectable"); const j = await r.json(); if (Array.isArray(j)) { apps = j; return true; } } catch (e) { console.error(e); }
      return false;
    };

    const LIST_FNS = ["getRunningGames", "getVisibleRunningGames", "getCandidateGames"];
    const ONE_FNS = ["getVisibleGame", "getRunningGame"];
    const ensureHooks = () => {
      if (!RunningGameStore) return;
      const S = RunningGameStore;
      const put = (fn, build) => {
        if (typeof S[fn] !== "function") return;
        if (wrapped[fn] && S[fn] === wrapped[fn]) return;
        const inner = S[fn]; const w = build(inner);
        wrapped[fn] = w; inners[fn] = inner; S[fn] = w;
      };
      for (const fn of LIST_FNS) put(fn, (inner) => function (...args) {
        const real = inner.apply(S, args) ?? [];
        if (!Array.isArray(real)) return real;
        const f = fakes().filter(g => !real.some(r => r.id === g.id && r.pid === g.pid));
        return f.length ? [...real, ...f] : real;
      });
      for (const fn of ONE_FNS) put(fn, (inner) => function (...args) { return inner.apply(S, args) ?? fakes()[0] ?? null; });
      put("getGameForPID", (inner) => function (pid) { return fakes().find(g => g.pid === pid) ?? inner.call(S, pid); });
    };
    const removeHooks = () => {
      if (!RunningGameStore) return;
      for (const fn of Object.keys(wrapped)) {
        if (RunningGameStore[fn] === wrapped[fn]) RunningGameStore[fn] = inners[fn];
        delete wrapped[fn]; delete inners[fn];
      }
    };
    const dispatchGames = (removed, added) =>
      FluxDispatcher?.dispatch({ type: X.evRun, removed, added, games: RunningGameStore.getRunningGames() });
    const inStore = (g) => { try { return (RunningGameStore.getRunningGames() ?? []).some(r => r.id === g.id && r.pid === g.pid); } catch { return false; } };
    const startGuard = () => {
      if (guard) return;
      guard = setInterval(() => {
        if (!fakes().length) return;
        ensureHooks();
        const missing = fakes().filter(g => !inStore(g));
        if (missing.length) dispatchGames([], missing);
      }, GUARD_MS);
    };
    const stopGuard = () => { if (guard) { clearInterval(guard); guard = null; } };

    const sendActivity = (entry) => FluxDispatcher?.dispatch({
      type: X.evAct, socketId: entry.socketId,
      activity: { application_id: entry.app.id, name: entry.app.name, type: 0, flags: 0, timestamps: { start: entry.start } },
    });
    const clearActivity = (entry) => FluxDispatcher?.dispatch({ type: X.evAct, socketId: entry.socketId, activity: null });

    const activate = (app) => {
      const start = Date.now();
      const entry = { app, start, socketId: `AutoRPC-${app.id}`, usesActivity: false, game: null };
      if ((METODO === "game" || METODO === "both") && RunningGameStore) {
        ensureHooks();
        const exe = app.executables?.find(x => x.os === "win32") ?? app.executables?.[0];
        const safe = app.name.replace(/[\/\\:*?"<>|]/g, "");
        const exeName = (exe?.name ?? `${safe}.exe`).replace(">", "");
        const pid = Math.floor(Math.random() * 30000) + 1000;
        entry.game = {
          cmdLine: `C:\\Program Files\\${safe}\\${exeName}`, elevated: false, exeName,
          exePath: `c:/program files/${safe.toLowerCase()}/${exeName}`,
          hidden: false, isLauncher: false, id: app.id, name: app.name,
          pid, pidPath: [pid], processName: app.name, start,
