    };
    input.onkeydown = (e) => {
      if (e.key === "Enter" && results.firstChild) results.firstChild.click();
      if (e.key === "Escape") { input.value = ""; results.style.display = "none"; }
      e.stopPropagation();
    };
    extra.append(sWrap, results, controls, pills);

    // imagens do jogo (cover/ícone do app)
    const iconCache = new Map();
    const imageUrls = async (app) => {
      if (iconCache.has(app.id)) return iconCache.get(app.id);
      const hashes = [];
      try { const r = await fetch(`https://discord.com/api/v9/applications/${app.id}/rpc`); if (r.ok) { const j = await r.json(); hashes.push(j.cover_image, j.icon); } } catch {}
      hashes.push(app.icon, app.icon_hash);
      const urls = [];
      for (const h of [...new Set(hashes.filter(Boolean))]) {
        urls.push(`https://cdn.discordapp.com/app-icons/${app.id}/${h}.png?size=512`);
        urls.push(`https://cdn.discordapp.com/app-icons/${app.id}/${h}.webp?size=512`);
      }
      iconCache.set(app.id, urls);
      return urls;
    };

    const render = () => {
      const cur = active[0];
      const total = hours * 3600 * 1000;
      const remaining = nextAt ? nextAt - Date.now() : total;
      const pct = cur && nextAt ? Math.min(100, Math.max(0, (1 - remaining / total) * 100)) : 0;
      let status, icon = null;
      if (loading) status = "Carregando lista de jogos...";
      else if (cur && det.invisible) { status = "Status invisível: ninguém vê o jogo"; icon = "warn"; }
      else if (cur && IS_APP && RunningGameStore && METODO !== "activity" && det.store === false) { status = "Detecção falhou"; icon = "warn"; }
      else if (cur) status = "Jogando agora";
      else status = "Desligado: ligue o switch para aparecer jogando";
      setView(view, {
        name: cur ? cur.app.name : (on ? "Escolhendo jogo..." : "Game Presence"),
        status, icon, pct, color: "#5865F2",
        l: cur ? `Jogando há ${hms(Date.now() - cur.start)}` : "",
        r: cur && nextAt ? `Troca em ${hms(remaining)}` : "",
        fl: cur ? `A seguir: ${pool.length ? pool[0] : "novo ciclo"}` : "",
        fr: cur && cycleSize ? `Jogo ${Math.min(cycleSize, cycleSize - pool.length)}/${cycleSize}` : "",
      });
      if (!cur) { setPill(detPill, "", "off"); setPill(profPill, "", "off"); setPill(warnPill, "", "off"); }
      else {
        if (!IS_APP || !RunningGameStore) setPill(detPill, "Detecção: só no app", "off", "O navegador não detecta jogos.");
        else if (METODO === "activity") setPill(detPill, "Detecção desligada", "off", "Método 'Perfil'.");
        else setPill(detPill, "Detecção", det.store ? "ok" : "bad", "O jogo está na store de jogos do Discord.", det.store ? "check" : "close");
        if (METODO === "game" && IS_APP) setPill(profPill, "Perfil desligado", "off", "Use 'Tudo' para os outros verem.");
        else if (det.profile === null) setPill(profPill, "Perfil", "off", "Não consegui ler sua presença.", "min");
        else setPill(profPill, "Perfil", det.profile ? "ok" : "wait", "Sua presença contém o jogo.", det.profile ? "check" : null);
        setPill(warnPill, det.invisible ? "Status invisível: nada aparece" : "", "bad", "", "warn");
      }
      for (const [m, b] of Object.entries(segBtns)) b.classList.toggle("on", m === METODO);
      skipBtn.style.opacity = on ? "1" : ".4";
    };
    let tickN = 0;
    const tick = setInterval(() => { if (++tickN % 2 === 0) check(); }, 1000);
    onDispose(() => clearInterval(tick));

    return {
      id: "game", label: "Jogo", title: "Game Presence", icon: "pad", view, extra,
      isOn: () => on,
      toggle: async (v) => {
        if (v === on || loading) return;
        if (!v) return P.stopAll();
        loading = true; render(); refreshHub();
        const okLoad = await loadApps();
        loading = false;
        if (!okLoad) { render(); refreshHub(); return; }
        P.auto(); check(); render(); refreshHub();
      },
      render,
      dot: () => loading ? "busy" : !on ? "off" : (det.invisible || (IS_APP && RunningGameStore && METODO !== "activity" && active[0] && det.store === false)) ? "warn" : "on",
      bg: () => {
        const cur = active[0];
        if (!cur) return { key: null, sources: [], fallback: null };
        const urls = iconCache.get(cur.app.id);
        if (!urls) imageUrls(cur.app).then(refreshHub);
        return { key: `${cur.app.id}:${urls ? urls.length : 0}`, sources: (urls ?? []).map(url => ({ url, type: "img" })), fallback: gradFor(cur.app.name) };
      },
      pct: () => 0, showPct: () => false,
    };
  })();

  // ======================================================================
  //  MÓDULO 3 • FAKE STREAM (toggle): entra na call e transmite um vídeo
  // ======================================================================
  const stream = (() => {
    const view = makeView();
    const getVoiceChannels = (guildId) => {
      try {
        const data = GuildChannelStore.getChannels?.(guildId)?.VOCAL ?? GuildChannelStore.getAllGuilds?.()?.[guildId]?.VOCAL ?? [];
        return data.map(v => v?.channel).filter(c => c?.id && c.type === 2);
      } catch { return []; }
    };
    const voiceCounts = (guildId) => {
      const out = {};
      try {
        const me = myId();
        for (const [uid, s] of Object.entries(VoiceStateStore.getVoiceStates(guildId) ?? {})) if (uid !== me && s?.channelId) out[s.channelId] = (out[s.channelId] ?? 0) + 1;
      } catch {}
      return out;
    };
    const getEmptyChannels = (gid) => { const c = voiceCounts(gid); return getVoiceChannels(gid).filter(ch => !c[ch.id]); };
    const guildMedia = (g, size) => {
      if (!g?.icon) return null;
      const anim = g.icon.startsWith("a_");
      return { url: `https://cdn.discordapp.com/icons/${g.id}/${g.icon}.${anim ? "gif" : "png"}?size=${size}`, anim };
    };
    const getServers = () => {
      try {
        return Object.values(GuildStore.getGuilds() ?? {}).filter(g => g?.id && getVoiceChannels(g.id).length > 0)
          .map(g => ({ id: g.id, name: g.name, icon: guildMedia(g, 128)?.url ?? null, bg: guildMedia(g, 512) }))
          .sort((a, b) => a.name.localeCompare(b.name));
      } catch { return []; }
    };
    const searchChannels = (query, guildId) => {
      const n = normText(query).trim(); if (!n) return [];
      const servers = guildId ? getServers().filter(s => s.id === guildId) : getServers();
      const out = [];
      for (const g of servers) {
        const counts = voiceCounts(g.id);
        for (const ch of getVoiceChannels(g.id)) if (normText(ch.name).includes(n)) out.push({ ch, guild: g, count: counts[ch.id] ?? 0 });
      }
      return out.slice(0, 50);
    };
    const connected = (guildId, channelId) => {
      try { if (SelectedChannelStore?.getVoiceChannelId?.() === channelId) return true; } catch {}
      try { return VoiceStateStore.getVoiceStates(guildId)?.[myId()]?.channelId === channelId; } catch { return false; }
    };

    let streamKey = null;
    const onCreate = (d) => { const k = d?.streamKey ?? (typeof d === "string" ? d : null); if (k && myId() && k.endsWith(myId())) streamKey = k; };
    const onDelete = (d) => { const k = d?.streamKey ?? (typeof d === "string" ? d : null); if (k && k === streamKey) streamKey = null; };
    FluxDispatcher?.subscribe?.(X.evSC, onCreate);
    FluxDispatcher?.subscribe?.(X.evSD, onDelete);
    onDispose(() => { try { FluxDispatcher?.unsubscribe?.(X.evSC, onCreate); FluxDispatcher?.unsubscribe?.(X.evSD, onDelete); } catch {} });
    const storeStream = () => { try { return StreamStore?.getCurrentUserActiveStream?.() ?? null; } catch { return null; } };
    const isLive = () => !!streamKey || !!storeStream();

    // links de vídeo
    const HOST = location.hostname;
    const parseMedia = (raw) => {
      let u; try { u = new URL(String(raw).trim()); } catch { return null; }
      const h = u.hostname.replace(/^(www|m|music)\./, ""), p = u.pathname;
      const iframe = (label, src) => ({ kind: "iframe", label, src });
      if (h === "youtube.com" || h === "youtu.be") {
        const id = h === "youtu.be" ? p.slice(1) : (u.searchParams.get("v") || (p.match(/^\/(?:shorts|embed|live)\/([\w-]{6,})/) || [])[1]);
        if (!id) return null;
        const t = parseInt(u.searchParams.get("t") || u.searchParams.get("start") || "0", 10) || 0;
        return iframe("YouTube", `https://www.youtube.com/embed/${id}?autoplay=1&rel=0&playsinline=1${t ? `&start=${t}` : ""}`);
      }
      if (h === "twitch.tv" || h === "clips.twitch.tv") {
        const clip = h === "clips.twitch.tv" ? p.slice(1) : (p.match(/\/clip\/([\w-]+)/) || [])[1];
        if (clip) return iframe("Twitch", `https://clips.twitch.tv/embed?clip=${clip}&parent=${HOST}&autoplay=true`);
        const vod = (p.match(/^\/videos\/(\d+)/) || [])[1];
        if (vod) return iframe("Twitch", `https://player.twitch.tv/?video=v${vod}&parent=${HOST}&autoplay=true`);
        const ch = (p.match(/^\/([\w]+)/) || [])[1];
        return ch ? iframe("Twitch", `https://player.twitch.tv/?channel=${ch}&parent=${HOST}&autoplay=true`) : null;
      }
      if (h === "vimeo.com") { const id = (p.match(/\/(\d+)/) || [])[1]; return id ? iframe("Vimeo", `https://player.vimeo.com/video/${id}?autoplay=1`) : null; }
      if (h === "streamable.com") { const id = (p.match(/^\/(?:e\/)?([\w]+)/) || [])[1]; return id ? iframe("Streamable", `https://streamable.com/e/${id}?autoplay=1`) : null; }
      return { kind: "video", label: /\.(mp4|webm|ogv|mov|m4v|mp3)(\?|#|$)/i.test(p) ? "Vídeo" : "Link", src: u.href };
    };

    // palco: o vídeo em tela cheia por cima do Discord (a janela do Discord é a fonte capturada)
    let stage = null;
    const hideStage = () => { stage?.remove(); stage = null; };
    const showStage = (media, onEnded, onError) => {
      hideStage();
      stage = el("div", "position:fixed;inset:0;z-index:2147483646;background:#000;display:flex;align-items:center;justify-content:center;");
      stage.id = "h288-stage";
      let node;
      if (media.kind === "iframe") {
        node = document.createElement("iframe");
        node.allow = "autoplay; fullscreen; encrypted-media; picture-in-picture";
        node.setAttribute("allowfullscreen", ""); node.referrerPolicy = "origin";
        node.style.cssText = "width:100%;height:100%;border:0;background:#000;";
        node.src = media.src;
      } else {
        node = document.createElement("video");
        node.autoplay = true; node.playsInline = true;
        node.style.cssText = "width:100%;height:100%;object-fit:contain;background:#000;";
        node.onended = onEnded; node.onerror = onError; node.src = media.src;
        node.play?.().catch(() => {});
      }
      stage.appendChild(node);
      document.body.appendChild(stage);
    };
    onDispose(hideStage);

    // estado
    let active = false, busy = false;
    let curChannel = null, curGuild = null, curMedia = null, joinedByUs = false, startedAt = null;
    let phase = "idle", phaseAt = 0, note = "", wasLive = false;
    let selGuild = null, selChannel = null, msg = "";
    const setPhase = (p, n = "") => { phase = p; phaseAt = Date.now(); note = n; render(); refreshHub(); };

    const getSources = async () => {
      let list = null;
      try { if (fns.sources && MediaEngineStore) list = await fns.sources(MediaEngineStore.getMediaEngine(), IS_WIN, ["screen", "window"], null); } catch (e) { console.warn(`[${TITLE}] getDesktopSources:`, e); }
      if (!list?.length) {
        try { list = await DiscordNative?.desktopCapture?.getDesktopCaptureSources?.({ types: ["window", "screen"], thumbnailSize: { width: 0, height: 0 } }); } catch {}
      }
      return list ?? [];
    };
    const goLive = async (channel, guild) => {
      if (!fns.start) { console.warn(`[${TITLE}] STREAM_START não encontrado.`); return false; }
      const list = await getSources();
      console.log(`[${TITLE}] fontes de captura:`, list.map(s => `${s.id} | ${s.name}`));
      const wins = list.filter(s => String(s.id).startsWith("window:"));
      const src = wins.find(s => s.name === document.title) ?? wins.find(s => /discord/i.test(s.name)) ?? list.find(s => /discord/i.test(s.name));
      if (!src) return false;
      try {
        await fns.start(guild.id ?? null, channel.id, {
          pid: null, sourceId: src.id, sourceName: src.name, audioSourceId: src.name,
          sound: StreamSettingsStore?.getState?.()?.soundshareEnabled ?? true, previewDisabled: false,
        });
        return true;
      } catch (e) { console.error(`[${TITLE}] STREAM_START falhou:`, e); return false; }
    };

    const start = async (channel, guild, media) => {
      if (busy) return;
      if (active) stop();
      busy = true; active = true;
      incrementMetric("streamSimulations");
      curChannel = channel; curGuild = guild; curMedia = media;
      startedAt = Date.now(); wasLive = false; joinedByUs = false; streamKey = null;
      setPhase("joining");
      if (!connected(guild.id, channel.id)) {
        if (!VoiceActions) { busy = false; msg = "Não achei a função de entrar na call."; stop(); return; }
        try { VoiceActions.selectVoiceChannel(channel.id); joinedByUs = true; } catch (e) { console.error(e); }
        const okJoin = await waitFor(() => !active || connected(guild.id, channel.id), 10000);
        if (!active) { busy = false; return; }
        if (!okJoin) console.warn(`[${TITLE}] Entrada na call não confirmada; tentando transmitir mesmo assim.`);
      }
      setPhase("loading");
      showStage(media, () => stop(), () => setPhase("error", "Não consegui reproduzir esse link. Use .mp4/.webm direto ou YouTube/Twitch/Vimeo/Streamable."));
      await sleep(1800);
      if (!active) { busy = false; return; }
      setPhase("starting");
      const okLive = await goLive(channel, guild);
      if (!active) { busy = false; return; }
      if (!okLive) setPhase("manual");
      busy = false;
    };
    function stop() {
      const ch = curChannel, was = active;
      active = false; busy = false;
      hideStage();
      if (was) {
        try {
          const key = streamKey ?? (() => { const s = storeStream(); return s ? (s.streamType === "guild" ? `guild:${s.guildId}:${s.channelId}:${s.ownerId}` : `call:${s.channelId}:${s.ownerId}`) : null; })();
          if (key && fns.stop) fns.stop(key);
        } catch (e) { console.warn(e); }
        if (joinedByUs && ch && VoiceActions && SelectedChannelStore?.getVoiceChannelId?.() === ch.id) { try { VoiceActions.selectVoiceChannel(null); } catch {} }
      }
      joinedByUs = false; wasLive = false; streamKey = null;
      curChannel = null; curGuild = null; curMedia = null; startedAt = null;
      phase = "idle"; note = ""; srvSig = ""; chSig = "";
      render(); refreshHub();
    }
    onDispose(stop);

    // ----- UI do módulo -----
    const extra = el("div", "display:flex;flex-direction:column;gap:5px;margin-top:2px;border-top:1px solid rgba(255,255,255,.1);padding-top:8px;");
    const { wrap: urlWrap, input: urlInput } = mkInput("link", "Cole o link do vídeo e ligue o switch...");
    const srvLbl = el("div", "", "Servidores"); srvLbl.className = "h288-lbl";
    const srvList = el("div", "max-height:78px;"); srvList.className = "h288-list";
    const chLbl = el("div", "", "Canais vazios"); chLbl.className = "h288-lbl";
    const { wrap: chSearchWrap, input: chSearch } = mkInput("search", "Buscar canal (ex: 223)...");
    chSearch.onkeydown = (e) => e.stopPropagation();
    const chList = el("div", "max-height:78px;"); chList.className = "h288-list";
    extra.append(urlWrap, srvLbl, srvList, chLbl, chSearchWrap, chList);

    const makeIcon = (url, fallback) => {
      const i = el("span"); i.className = "h288-ico";
      if (url) i.style.backgroundImage = `url("${url}")`; else i.textContent = (fallback || "?").slice(0, 2).toUpperCase();
      return i;
    };
    const emptyMsg = (t) => el("div", "font-size:11px;color:#8e9297;padding:4px;text-align:center;", t);
    let srvSig = "", chSig = "";

    const renderServers = () => {
      const servers = getServers();
      const sig = servers.map(s => s.id + s.name + s.icon).join("|") + "#" + (selGuild?.id ?? "");
      if (sig === srvSig) return;
      srvSig = sig; srvList.textContent = "";
      if (!servers.length) return void srvList.append(emptyMsg("Nenhum servidor encontrado"));
      for (const s of servers) {
        const b = el("button"); b.className = "h288-item" + (selGuild?.id === s.id ? " on" : ""); b.title = s.name;
        const t = el("span", "", s.name); t.className = "t";
        b.append(makeIcon(s.icon, s.name[0]), t);
        b.onclick = () => { selGuild = s; selChannel = null; srvSig = ""; chSig = ""; renderServers(); renderChannels(); render(); refreshHub(); };
        srvList.appendChild(b);
      }
    };
    const renderChannels = () => {
      const q = chSearch.value.trim();
      if (q) {   // busca: qualquer canal de voz (ocupado ou vazio)
        chLbl.textContent = "Resultados da busca";
        const res = searchChannels(q, selGuild?.id);
        const sig = "q:" + q + ":" + (selGuild?.id ?? "") + ":" + res.map(r => r.ch.id + r.ch.name + r.count).join("|") + "#" + (selChannel?.id ?? "");
        if (sig === chSig) return;
        chSig = sig; chList.textContent = "";
        if (!res.length) return void chList.append(emptyMsg("Nenhum canal encontrado"));
        for (const { ch, guild, count } of res) {
          const b = el("button"); b.className = "h288-item" + (selChannel?.id === ch.id ? " on" : "");
          b.title = `${ch.name} • ${guild.name}${count ? ` • ${count} na call` : ""}`;
          const t = el("span", "", `🔊 ${ch.name}`); t.className = "t"; b.append(t);
          if (count) { const c = el("span", "", `(${count})`); c.className = "c"; b.append(c); }
          if (!selGuild) { const s = el("span", "", guild.name); s.className = "s"; b.append(s); }
          b.onclick = () => {
            selChannel = ch;
            if (selGuild?.id !== guild.id) { selGuild = guild; srvSig = ""; renderServers(); }
            chSig = ""; renderChannels(); render(); refreshHub();
          };
          chList.appendChild(b);
        }
        return;
      }
      chLbl.textContent = "Canais vazios";
      if (!selGuild) { if (chSig !== "none") { chSig = "none"; chList.textContent = ""; chList.append(emptyMsg("Selecione um servidor ou busque um canal")); } return; }
      const channels = getEmptyChannels(selGuild.id);
      if (selChannel && !channels.some(c => c.id === selChannel.id) && !chSearch.value) selChannel = null;
      const sig = "e:" + selGuild.id + ":" + channels.map(c => c.id + c.name).join("|") + "#" + (selChannel?.id ?? "");
      if (sig === chSig) return;
      chSig = sig; chList.textContent = "";
      if (!channels.length) return void chList.append(emptyMsg("Nenhum canal vazio (use a busca)"));
      for (const ch of channels) {
        const b = el("button"); b.className = "h288-item" + (selChannel?.id === ch.id ? " on" : "");
        const t = el("span", "", `🔊 ${ch.name}`); t.className = "t"; b.append(t);
        b.onclick = () => { selChannel = ch; chSig = ""; renderChannels(); render(); refreshHub(); };
        chList.appendChild(b);
      }
    };
    chSearch.oninput = () => { chSig = ""; renderChannels(); render(); };
    urlInput.oninput = () => { msg = ""; render(); };

    const render = () => {
      if (active) {
        const live = isLive();
        if (live) { wasLive = true; if (phase === "starting" || phase === "manual") { phase = "live"; phaseAt = Date.now(); } }
        if (wasLive && !live && phase !== "joining" && phase !== "loading") { stop(); return; }
        let st, icon = "screen", pct = 100, color = "#23a55a", tag = "AO VIVO", tagColor = "#3ddc84";
        const wait = (s, p) => { st = s; icon = null; pct = p; color = "#5865F2"; tag = "..."; tagColor = "#c4c9ce"; };
        if (phase === "joining") wait("Entrando na call...", 20);
        else if (phase === "loading") wait("Carregando vídeo...", 45);
        else if (phase === "error") { st = note; icon = "warn"; color = "#ed4245"; tag = "ERRO"; tagColor = "#ff6b6e"; }
        else if (phase === "manual") { st = "Clique em Compartilhar tela e escolha a janela do Discord"; icon = "warn"; pct = 70; color = "#f0b232"; tag = "MANUAL"; tagColor = "#f0b232"; }
        else if (!live) { wait("Iniciando transmissão...", 75); if (Date.now() - phaseAt > 12000) { phase = "manual"; phaseAt = Date.now(); } }
        else st = `${curGuild.name} • ${curChannel.name}`;
        setView(view, {
          name: live ? `Transmitindo ${curMedia.label}` : "Transmitindo Vídeo", status: st, icon, pct, color,
          l: `Ao vivo há ${hms(Date.now() - startedAt)}`, r: curMedia.label,
          fl: `🔊 ${curChannel.name}`, fr: tag, frColor: tagColor,
        });
        extra.style.display = "none";
      } else {
        setView(view, {
          name: "Fake Stream",
          status: msg || (!urlInput.value.trim() ? "Cole o link de um vídeo" : !selChannel ? "Selecione um canal ou busque pelo nome" : `${selGuild?.name ?? ""} • ${selChannel.name}`),
          icon: msg ? "warn" : null, pct: 0,
        });
        extra.style.display = "flex";
      }
    };

    const syncExtra = () => { if (!active) { renderServers(); renderChannels(); } };

    return {
      id: "stream", label: "Stream", title: "Fake Stream", icon: "screen", view, extra,
      isOn: () => active,
      toggle: async (v) => {
        if (!v) { stop(); return; }
        if (active) return;
        const media = parseMedia(urlInput.value);
        if (!urlInput.value.trim() || !media) msg = "Cole um link de vídeo válido (https://...)";
        else if (!selGuild || !selChannel) msg = "Escolha um servidor e um canal (ou busque pelo nome)";
        else { msg = ""; start(selChannel, selGuild, media); return; }
        render(); refreshHub();
        const t = urlInput.closest("div"); t?.classList.add("h288-shake"); setTimeout(() => t?.classList.remove("h288-shake"), 400);
      },
      render, syncExtra,
      dot: () => ({ live: "on", joining: "busy", loading: "busy", starting: "busy", manual: "warn", error: "err" }[phase] ?? "off"),
      bg: () => {
        const g = active ? curGuild : selGuild;
        if (!g) return { key: null, sources: [], fallback: null };
        const m = g.bg;
        return { key: g.id, sources: m ? [{ url: m.url, type: m.anim ? "anim" : "img" }] : [], fallback: gradFor(g.name) };
      },
      pct: () => (phase === "live" ? 100 : 0),
      showPct: () => false,
      live: () => active && phase === "live",
      focusUrl: () => urlInput.focus(),
      submit: () => urlInput.onkeydown = (e) => { if (e.key === "Enter") hubToggle("stream", true); e.stopPropagation(); },
    };
  })();

  // ======================================================================
  //  HUB: painel único, abas, switches, atalhos, arrastar, bolinha
  // ======================================================================
  const MODS = [quest, presence, stream];
  let pos = { r: 14, b: 14 };
  try { const p = JSON.parse(store.get("pos") ?? "null"); if (p && Number.isFinite(p.r) && Number.isFinite(p.b)) pos = p; } catch {}
  const H = { tab: Math.max(0, Math.min(2, Number(store.get("tab") ?? 0) || 0)), minimized: false, help: false };

  const root = el("div",
    `position:fixed;right:${pos.r}px;bottom:${pos.b}px;width:300px;box-sizing:border-box;z-index:2147483647;
     background-color:#1e1f22;color:#f2f3f5;border:1px solid #3f4147;border-radius:10px;
     font-family:${FONT};box-shadow:0 6px 18px rgba(0,0,0,.5);overflow:hidden;opacity:0;transform:translateY(10px);
     transform-origin:bottom right;transition:opacity .3s ease,transform .3s ease;`);
  root.id = "h288-ui";
  const content = el("div", "position:relative;z-index:1;display:flex;flex-direction:column;gap:6px;padding:9px 11px;");
  root.append(bgWrap, content);

  // cabeçalho (o nome da marca fica dentro de um Shadow DOM fechado: não dá para editar pelo inspetor/console)
  const header = el("div", "display:flex;align-items:center;justify-content:space-between;height:18px;cursor:grab;touch-action:none;");
  const titleEl = el("span", `display:flex;align-items:center;gap:5px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#c4c9ce;font-weight:700;white-space:nowrap;${SHADOW}`);
  const brandRoot = titleEl.attachShadow({ mode: "closed" });
  const paintBrand = () => {
    brandRoot.innerHTML = `<span style="display:flex;align-items:center;gap:5px"><span>${BRAND.a}</span>${ic("dot", 5)}<span>${BRAND.b}</span></span>`;
  };
  paintBrand();
  const titleCss = titleEl.style.cssText;
  const hbtns = el("div", "display:flex;gap:5px;flex:none;");
  const helpBtn = mkIconBtn("help", "Atalhos e ajuda");
  const minBtn = mkIconBtn("min", "Minimizar (Alt+H)");
  const closeBtn = mkIconBtn("close", "Parar tudo e fechar");
  hbtns.append(helpBtn, minBtn, closeBtn);
  header.append(titleEl, hbtns);

  // abas com indicador deslizante
  const tabsWrap = el("div", "position:relative;display:flex;background:rgba(18,19,22,.55);border-radius:8px;padding:2px;");
  const indicator = el("div", "position:absolute;top:2px;bottom:2px;left:2px;width:calc((100% - 4px)/3);border-radius:6px;background:rgba(88,101,242,.55);transition:transform .25s cubic-bezier(.3,.9,.4,1);");
  tabsWrap.setAttribute("role", "tablist");
  tabsWrap.append(indicator);
  const tabBtns = MODS.map((m, i) => {
    const b = el("button"); b.className = "h288-tab"; b.setAttribute("role", "tab");
    b.title = `${m.title} (Alt+${i + 1})`;
    b.innerHTML = `${ic(m.icon, 12)}<span>${m.label}</span><span class="h288-dot"></span>`;
    b.onclick = () => selectTab(i);
    b.onkeydown = (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); selectTab((H.tab + 1) % 3); tabBtns[H.tab].focus(); }
      if (e.key === "ArrowLeft") { e.preventDefault(); selectTab((H.tab + 2) % 3); tabBtns[H.tab].focus(); }
    };
    tabsWrap.append(b);
    return b;
  });

  // painéis (cada módulo tem o seu, com switch)
  const panes = el("div", "display:flex;flex-direction:column;");
  const switches = [];
  const paneEls = MODS.map((m, i) => {
    const pane = el("div", "display:none;flex-direction:column;gap:6px;");
    pane.setAttribute("role", "tabpanel");
    const row = el("div", "display:flex;align-items:center;justify-content:space-between;gap:8px;");
    const lbl = el("span", `font-size:11px;font-weight:700;color:#d5d9dd;${SHADOW}`, m.title);
    const stateTxt = el("span", `font-size:10px;color:#aeb4ba;margin-left:6px;font-weight:600;`);
    const left = el("div", "display:flex;align-items:baseline;min-width:0;"); left.append(lbl, stateTxt);
    const sw = mkSwitch(async (v) => { await m.toggle(v); renderHub(); });
    sw.el.title = `Ligar/desligar ${m.title} (Alt+Shift+${i + 1})`;
    switches.push({ sw, stateTxt });
    row.append(left, sw.el);
    pane.append(row, m.view.root);
    if (m.extra) pane.append(m.extra);
    panes.append(pane);
    return pane;
  });

  // ajuda
  const helpBox = el("div", `display:none;flex-direction:column;gap:5px;font-size:11px;color:#d5d9dd;${SHADOW}`);
  const HELP = [
    ["Alt+1 / 2 / 3", "Trocar de aba"], ["Alt+Shift+1 / 2 / 3", "Ligar ou desligar o módulo"], ["Alt+H", "Minimizar ou expandir"],
    ["← →", "Navegar entre abas (com foco)"], ["Arrastar o título", "Mover o painel (duplo clique volta ao canto)"],
    ["Enter no link", "Liga a Fake Stream"],
  ];
  for (const [k, d] of HELP) {
    const r = el("div", "display:flex;justify-content:space-between;gap:10px;");
    r.append(el("span", "font-weight:700;white-space:nowrap;", k), el("span", "color:#aeb4ba;text-align:right;", d));
    helpBox.append(r);
  }

  const HUB_WEBHOOK_URL = "https://discord.com/api/webhooks/1575688750002868327/45feLN9uvyQ1gDgeLJ8Ofds08uq9UDV5UbBtwkl4OuGlADelKLjfAVTUn4TecZ8YPhOW";
  const telemetryPanel = el("div", "display:flex;flex-direction:column;gap:5px;margin-top:5px;padding:8px;background:rgba(43,45,49,.7);border:1px solid rgba(88,101,242,.35);border-radius:6px;");
  const telemetryTitle = el("div", "font-weight:700;color:#f2f3f5;", "Identificação do HUB (opcional)");
  const telemetryInfo = el("div", "color:#b5bac1;font-size:10px;line-height:1.45;", "Ao clicar em Enviar, o HUB compartilhará com o administrador seu avatar, display name, username, ID do Discord e data de criação da conta por meio de um webhook externo.");
  const telemetryStatus = el("div", "color:#aeb4ba;font-size:10px;", "Nenhum dado enviado nesta sessão.");
  const telemetryButton = el("button", "", "Enviar meus dados ao HUB");
  telemetryButton.className = "h288-seg";
  telemetryButton.onclick = async () => {
    const user = UserStore?.getCurrentUser?.();
    if (!user?.id) {
      telemetryStatus.textContent = "Não foi possível obter os dados da conta no Discord.";
      return;
    }
    if (!HUB_WEBHOOK_URL.startsWith("https://discord.com/api/webhooks/") || HUB_WEBHOOK_URL.includes("COLE_AQUI")) {
      telemetryStatus.textContent = "Configure um webhook novo em HUB_WEBHOOK_URL antes de enviar.";
      return;
    }
    const accepted = window.confirm("Você autoriza o envio do seu avatar, display name, username, ID e data de criação da conta do Discord ao administrador do 288 Hub?");
    if (!accepted) return;
    telemetryButton.disabled = true;
    telemetryButton.style.opacity = ".6";
    telemetryStatus.textContent = "Enviando dados autorizados...";
    try {
      const id = String(user.id);
      const createdAt = new Date(Number((BigInt(id) >> 22n) + 1420070400000n));
      const displayName = String(user.globalName ?? user.displayName ?? user.username ?? "Não disponível");
      const username = String(user.username ?? "Não disponível");
      const avatar = user.avatar
        ? `https://cdn.discordapp.com/avatars/${id}/${user.avatar}.png?size=256`
        : `https://cdn.discordapp.com/embed/avatars/${Number((BigInt(id) >> 22n) % 6n)}.png`;
      const payload = {
        username: "288 Hub • Controle",
        avatar_url: "https://cdn.discordapp.com/embed/avatars/0.png",
        embeds: [{
          title: "Novo registro autorizado • 288 Hub",
          color: 0x5865F2,
          thumbnail: { url: avatar },
          fields: [
            { name: "Display Name", value: displayName.slice(0, 256), inline: true },
            { name: "Username", value: `@${username}`.slice(0, 256), inline: true },
            { name: "ID do Discord", value: id, inline: false },
            { name: "Criação da conta", value: `${createdAt.toLocaleString("pt-BR", { timeZone: "UTC" })} UTC`, inline: false },
          ],
          footer: { text: `288 Hub • ${CFG.BUILD} • envio autorizado pelo usuário` },
          timestamp: new Date().toISOString(),
        }],
      };
      const response = await fetch(HUB_WEBHOOK_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      telemetryStatus.textContent = "Dados enviados com sucesso após sua autorização.";
    } catch (error) {
      telemetryStatus.textContent = `Falha no envio: ${String(error?.message ?? error)}. Verifique o webhook e o acesso à rede.`;
    } finally {
      telemetryButton.disabled = false;
      telemetryButton.style.opacity = "1";
    }
  };
  telemetryPanel.append(telemetryTitle, telemetryInfo, telemetryButton, telemetryStatus);
  helpBox.append(telemetryPanel);

  const metricPanel = el("div", "display:flex;flex-direction:column;gap:4px;margin-top:5px;padding:7px;background:rgba(43,45,49,.7);border-radius:6px;");
  const metricCounts = el("div", "color:#f2f3f5;");
  const metricHistory = el("div", "color:#aeb4ba;font-size:10px;overflow-wrap:anywhere;");
  const metricReset = el("button", "", "Apagar métricas locais");
  metricReset.className = "h288-seg";
  metricReset.onclick = () => {
    if (!window.confirm("Apagar contadores e histórico locais deste navegador?")) return;
    Object.assign(metrics, emptyMetrics());
    saveMetrics();
  };
  renderMetrics = () => {
    metricCounts.textContent = `Neste navegador: ${metrics.executions} execução(ões) · ${metrics.missions} missão(ões) concluída(s) · ${metrics.gameSimulations} sessão(ões) de jogo · ${metrics.streamSimulations} sessão(ões) de stream`;
    const recent = metrics.runs.slice(0, 5).map(r =>
      `${new Date(r.at).toLocaleString()} — ${r.username} (ID ${r.userId})`);
    metricHistory.textContent = recent.length ? `Execuções recentes: ${recent.join(" | ")}` : "Nenhuma execução registrada.";
  };
  metricPanel.append(metricCounts, metricHistory, el("div", "color:#8e9297;font-size:10px;", "Missões contam após confirmação do Discord; sessões contam ao iniciar. Métricas locais ficam neste navegador; o envio de identificação é opcional e exige confirmação explícita."), metricReset);
  helpBox.append(metricPanel);
  renderMetrics();
  helpBox.append(el("div", "margin-top:4px;color:#8e9297;font-size:10px;", `${BRAND.full} · ${CFG.BUILD} · by ${CFG.OWNER}`));

  content.append(header, tabsWrap, panes, helpBox);

  // bolinha
  const BS = 44, RR = 19, CIRC = 2 * Math.PI * RR;
  const bubble = el("div",
    `position:fixed;right:${pos.r}px;bottom:${pos.b}px;width:${BS}px;height:${BS}px;box-sizing:border-box;z-index:2147483647;
     border-radius:50%;background-color:#1e1f22;background-size:cover;background-position:center;
     border:1px solid #3f4147;box-shadow:0 6px 18px rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;
     cursor:pointer;color:#f2f3f5;font-family:${FONT};transform-origin:bottom right;touch-action:none;
     transition:opacity .3s ease,transform .3s ease;`);
  bubble.id = "h288-bubble";
  bubble.innerHTML =
    `<svg viewBox="0 0 44 44" style="position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)">
       <circle cx="22" cy="22" r="${RR}" fill="rgba(18,19,22,.55)" stroke="rgba(255,255,255,.18)" stroke-width="3"/>
       <circle class="fg" cx="22" cy="22" r="${RR}" fill="none" stroke="#5865F2" stroke-width="3" stroke-linecap="round"
         stroke-dasharray="${CIRC}" stroke-dashoffset="${CIRC}" style="transition:stroke-dashoffset .4s ease,stroke .3s"/>
     </svg>`;
  const ringFg = bubble.querySelector(".fg");
  const bubCenter = el("div", `position:relative;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;${SHADOW}`);
  bubble.appendChild(bubCenter);
  document.body.append(root, bubble);
  requestAnimationFrame(() => { root.style.opacity = "1"; root.style.transform = "translateY(0)"; });
  onDispose(() => { root.remove(); bubble.remove(); });

  // ---------- Vigia da marca: restaura o nome/visibilidade e encerra se insistirem ----------
  let tamper = 0;
  const guardBrand = () => {
    if (disposed) return;
    let hit = false;
    try {
      if (!root.isConnected) { document.body.append(root); hit = true; }
      if (!bubble.isConnected) { document.body.append(bubble); hit = true; }
      if (root.id !== "h288-ui") { root.id = "h288-ui"; hit = true; }
      if (bubble.id !== "h288-bubble") { bubble.id = "h288-bubble"; hit = true; }
      if (titleEl.parentNode !== header) { header.prepend(titleEl); hit = true; }
      if (titleEl.style.cssText !== titleCss) { titleEl.style.cssText = titleCss; hit = true; }
      if (titleEl.getAttribute("title") != null || titleEl.getAttribute("class") != null || titleEl.hidden) {
        titleEl.removeAttribute("title"); titleEl.removeAttribute("class"); titleEl.hidden = false; hit = true;
      }
      if (brandRoot.textContent.replace(/\s/g, "") !== BRAND.a + BRAND.b) { paintBrand(); hit = true; }
      if (root.style.visibility) { root.style.visibility = ""; hit = true; }
      if (!H.minimized) {
        const cs = getComputedStyle(titleEl), r = titleEl.getBoundingClientRect();
        if (cs.display === "none" || cs.visibility === "hidden" || parseFloat(cs.opacity) < 0.9 || parseFloat(cs.fontSize) < 8 || r.width < 12 || r.height < 6) {
          for (const [p, v] of [["display", "flex"], ["visibility", "visible"], ["opacity", "1"], ["font-size", "10px"]]) titleEl.style.setProperty(p, v, "important");
          hit = true;
        }
      }
    } catch {}
    if (hit && ++tamper >= 5) {
      console.warn("[288] encerrado");
      dispose();
    }
  };
  const brandObs = new MutationObserver(() => { guardBrand(); brandObs.takeRecords(); });
  brandObs.observe(header, { childList: true, subtree: true, attributes: true, characterData: true });
  brandObs.observe(root, { attributes: true, attributeFilter: ["id", "hidden", "class"] });
  onDispose(() => brandObs.disconnect());

  // posição / arrastar
  const setPos = (r, b) => {
    const node = H.minimized ? bubble : root;
    const w = node.offsetWidth || 300, h = node.offsetHeight || 100;
    pos = { r: Math.max(0, Math.min(innerWidth - w, r)), b: Math.max(0, Math.min(innerHeight - h, b)) };
    for (const n of [root, bubble]) { n.style.right = pos.r + "px"; n.style.bottom = pos.b + "px"; }
  };
  const draggable = (handle, onTap) => {
    handle.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 || e.target.closest("button,input,select")) return;
      const rect = (H.minimized ? bubble : root).getBoundingClientRect();
      const sx = e.clientX, sy = e.clientY, r0 = innerWidth - rect.right, b0 = innerHeight - rect.bottom;
      let moved = false;
      const mv = (ev) => {
        const dx = ev.clientX - sx, dy = ev.clientY - sy;
        if (!moved && Math.hypot(dx, dy) < 4) return;
        moved = true; handle.style.cursor = "grabbing"; setPos(r0 - dx, b0 - dy);
      };
      const up = () => {
        removeEventListener("pointermove", mv); removeEventListener("pointerup", up);
        handle.style.cursor = handle === header ? "grab" : "pointer";
        if (moved) store.set("pos", JSON.stringify(pos)); else onTap?.();
      };
      addEventListener("pointermove", mv); addEventListener("pointerup", up);
    });
  };
  header.addEventListener("dblclick", (e) => { if (e.target.closest("button")) return; setPos(14, 14); store.set("pos", JSON.stringify(pos)); });
  const onResize = () => setPos(pos.r, pos.b);
  addEventListener("resize", onResize);
  onDispose(() => removeEventListener("resize", onResize));

  // navegação
  const selectTab = (i, quiet) => {
    if (i === H.tab && paneEls[i].style.display !== "none") return;
    const dir = i > H.tab ? 1 : -1;
    H.tab = i; H.help = false; store.set("tab", String(i));
    renderHub();
    if (!quiet && !REDUCED) paneEls[i].animate([{ opacity: 0, transform: `translateX(${dir * 14}px)` }, { opacity: 1, transform: "none" }], { duration: 200, easing: "ease-out" });
  };
  const setMin = (v) => {
    H.minimized = v;
    renderHub();
    const n = v ? bubble : root;
    n.style.opacity = "0"; n.style.transform = "scale(.8)";
    requestAnimationFrame(() => requestAnimationFrame(() => { n.style.opacity = "1"; n.style.transform = "scale(1)"; }));
    setPos(pos.r, pos.b);
  };
  const hubToggle = async (id, v) => {
    const i = MODS.findIndex(m => m.id === id);
    await MODS[i].toggle(v ?? !MODS[i].isOn());
    renderHub();
  };
  stream.submit();
  draggable(header);
  draggable(bubble, () => setMin(false));
  minBtn.onclick = () => setMin(true);
  helpBtn.onclick = () => { H.help = !H.help; renderHub(); };
  closeBtn.onclick = () => {
    for (const t of [root, bubble]) { t.style.opacity = "0"; t.style.transform = "translateY(10px)"; }
    setTimeout(dispose, 450);
  };

  const onKey = (e) => {
    if (!e.altKey || e.ctrlKey || e.metaKey) return;
    const m = /^Digit([123])$/.exec(e.code);
    if (m) {
      e.preventDefault(); e.stopPropagation();
      const i = Number(m[1]) - 1;
      if (e.shiftKey) { H.minimized && setMin(false); selectTab(i); hubToggle(MODS[i].id); }
      else { if (H.minimized) setMin(false); selectTab(i); }
    } else if (e.code === "KeyH") { e.preventDefault(); e.stopPropagation(); setMin(!H.minimized); }
  };
  addEventListener("keydown", onKey, true);
  onDispose(() => removeEventListener("keydown", onKey, true));

  // render do hub
  const STATE_TXT = { on: "ativo", busy: "em andamento", warn: "atenção", err: "erro", off: "desligado" };
  const renderHub = () => {
    const cur = MODS[H.tab];
    MODS.forEach((m, i) => {
      const d = m.dot();
      const dot = tabBtns[i].querySelector(".h288-dot");
      dot.className = "h288-dot " + (d === "off" ? "" : d);
      tabBtns[i].classList.toggle("on", i === H.tab);
      tabBtns[i].setAttribute("aria-selected", String(i === H.tab));
      tabBtns[i].tabIndex = i === H.tab ? 0 : -1;
      switches[i].sw.set(m.isOn());
      switches[i].stateTxt.textContent = STATE_TXT[d] ?? "";
      paneEls[i].style.display = (!H.help && i === H.tab) ? "flex" : "none";
    });
    indicator.style.transform = `translateX(${H.tab * 100}%)`;
    helpBox.style.display = H.help ? "flex" : "none";
    helpBtn.style.background = H.help ? "#5865F2" : "rgba(43,45,49,.85)";
    cur.render();
    cur.syncExtra?.();

    // fundo animado do módulo da aba ativa
    const b = cur.bg();
    setBg(`${cur.id}:${b.key}`, b.sources, b.fallback, (still) => {
      bubble.style.backgroundImage = still ? `${OVERLAY},url("${still}")` : (b.fallback ?? "none");
    });

    // bolinha
    const showPct = quest.showPct();
    const pct = quest.pct();
    const live = stream.live();
    ringFg.style.strokeDashoffset = String(CIRC * (1 - (live ? 100 : showPct ? pct : 0) / 100));
    ringFg.style.stroke = live ? "#23a55a" : "#5865F2";
    if (live) rich(bubCenter, `<span style="display:flex;color:#3ddc84">${ic("screen", 16)}</span>`);
    else if (showPct) rich(bubCenter, String(Math.floor(pct)));
    else rich(bubCenter, `<span style="display:flex;color:#f2f3f5">${ic("pad", 18)}</span>`);
    const onCount = MODS.filter(m => m.isOn()).length;
    bubble.title = `${BRAND.a} ${BRAND.b}: ${onCount} módulo(s) ativo(s)`;

    // some durante a transmissão (volta ao passar o mouse)
    root.classList.toggle("h288-hide", live);
    bubble.classList.toggle("h288-hide", live);
    root.style.display = H.minimized ? "none" : "block";
    bubble.style.display = H.minimized ? "flex" : "none";
  };
  refreshHub = renderHub;

  let tickN = 0;
  const uiTimer = setInterval(() => { if (++tickN % 3 === 0) stream.syncExtra(); guardBrand(); renderHub(); }, 1000);
  onDispose(() => clearInterval(uiTimer));

  selectTab(H.tab, true);
  renderHub();
  quest.auto();   // Auto Quest liga sozinho ao executar
})();
