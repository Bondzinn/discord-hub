    const detPill = pill(), profPill = pill(), warnPill = pill();
    pills.append(badge, detPill, profPill, warnPill);
    const PILL = { ok: ["rgba(61,220,132,.16)", "#3ddc84"], wait: ["rgba(240,178,50,.16)", "#f0b232"], bad: ["rgba(237,66,69,.18)", "#ff6b6e"], off: ["rgba(255,255,255,.08)", "#b5bac1"] };
    const setPill = (p, text, kind, title = "", icon = null) => {
      rich(p, text ? (icon ? ic(icon, 10) : "") + esc(text) : "");
      p.title = title; p.style.background = PILL[kind][0]; p.style.color = PILL[kind][1];
