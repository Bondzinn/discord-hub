    const controls = el("div", "display:flex;gap:6px;align-items:center;");
    const seg = el("div", "display:flex;flex:1;background:rgba(43,45,49,.85);border-radius:6px;padding:2px;gap:2px;");
    const SEGS = [["both", "Tudo", "Detecção + perfil"], ["game", "Detecção", "Só detecção (app)"], ["activity", "Perfil", "Só presença no perfil"]];
    const segBtns = {};
    for (const [m, label, title] of SEGS) {
