    const countEls = {};
    const catCounts = () => {
      const c = { video: 0, game: 0, stream: 0, activity: 0 };
      try { for (const q of pending()) c[CAT[usableTask(q)]]++; } catch {}
      return c;
    };
    const updateExtra = () => {
      const c = catCounts();
      for (const cat of ORDER) {
        const txt = c[cat] ? `${c[cat]} pendente${c[cat] > 1 ? "s" : ""}` : "";
        if (countEls[cat] && countEls[cat].textContent !== txt) countEls[cat].textContent = txt;
      }
      const can = running && !!curId && !S.finished && !ctl.cancelled;
      skipBtn.disabled = !can; skipBtn.style.opacity = can ? "1" : ".4"; skipBtn.style.cursor = can ? "pointer" : "not-allowed";
    };
    const move = (i, d) => {
