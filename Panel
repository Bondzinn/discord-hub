    const b = el("button", "position:relative;width:38px;height:20px;border-radius:10px;border:none;padding:0;cursor:pointer;flex:none;transition:background .2s;background:#4e5058;");
    b.setAttribute("role", "switch"); b.setAttribute("aria-checked", "false");
    const knob = el("span", "position:absolute;top:2px;left:2px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .2s cubic-bezier(.3,.9,.4,1);box-shadow:0 1px 3px rgba(0,0,0,.4);");
    b.appendChild(knob);
    let state = false;
    const set = (v) => {
      v = !!v;
      if (v === state && b._init) return;
      state = v; b._init = true;
      b.setAttribute("aria-checked", String(v));
      b.style.background = v ? "#23a55a" : "#4e5058";
      knob.style.transform = v ? "translateX(18px)" : "translateX(0)";
    };
    b.onclick = () => onChange(!state);
    set(false);
    return { el: b, set, get: () => state };
  };

  // ---------- Estilos ----------
  const styleTag = el("style");
  styleTag.id = "h288-style";
  styleTag.textContent = `
