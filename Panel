    const shuffle = (arr) => { const a = [...arr]; for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
    const nextRandom = () => {
      if (!pool.length) {
        pool = shuffle([...new Set(POPULAR)].filter(n => findApp(n)));
        cycleSize = pool.length;
        if (pool.length > 1 && pool[0] === lastPlayed) pool.push(pool.shift());
      }
      return pool.shift();
    };
    const check = () => {
      const cur = active[0];
      det.invisible = false;
      if (!cur) { det.store = null; det.profile = null; return; }
      try { det.store = RunningGameStore ? inStore({ id: cur.app.id, pid: cur.game?.pid }) : null; } catch { det.store = null; }
      try {
        const me = myId();
        if (me && PresenceStore) {
          const acts = PresenceStore.getActivities(me) ?? [];
          det.profile = acts.some(a => a.application_id === cur.app.id || a.name === cur.app.name);
          det.invisible = PresenceStore.getStatus(me) === "invisible";
        } else det.profile = null;
      } catch { det.profile = null; }
    };

    const rotateTick = () => {
