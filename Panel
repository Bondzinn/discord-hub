      async pick(name) {
        if (!(await loadApps())) return;
        const app = findApp(name); if (!app) return;
        on = true; paused = false;
        stopRotate();
        [...active].forEach(deactivate);
        P.play(app);
        nextAt = Date.now() + hours * 3600 * 1000;
        timer = setInterval(rotateTick, hours * 3600 * 1000);
      },
      skip() { if (!on) return; stopRotate(); rotateTick(); timer = setInterval(rotateTick, hours * 3600 * 1000); },
      setHours(h) {
        hours = h;
        if (!on || !active.length) return render();
        stopRotate(); nextAt = Date.now() + hours * 3600 * 1000;
        timer = setInterval(rotateTick, hours * 3600 * 1000); render();
      },
      metodo(m) {
        if (!["both", "game", "activity"].includes(m)) return;
        const wasOn = on;
        P.stopAll(); METODO = m;
        if (wasOn) P.auto();
      },
      auto() { on = true; stopRotate(); rotateTick(); timer = setInterval(rotateTick, hours * 3600 * 1000); },
      stopAll() { on = false; stopRotate(); [...active].forEach(deactivate); stopGuard(); removeHooks(); render(); refreshHub(); },
