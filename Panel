      } else if (S.pulled > 0) {
        S.name = "Missões puladas"; S.status = `${S.pulled} missão(ões) pulada(s). Ligue o switch para tentar de novo.`;
      } else {
        S.name = "Nenhuma missão encontrada"; S.status = "Aceite missões na página de Quests e ligue o switch.";
      }
      render();
    };

    const rescan = () => {
      if (running || unavailable) return;
      ctl.cancelled = false; ctl.paused = false; ctl.skip = false; ctl.cancel = null; ctl.session = null;
      failed.clear(); tries.clear(); skipped.clear();
